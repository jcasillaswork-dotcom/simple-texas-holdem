# Where accounts are stored.
#   local  = in each browser (default, no server needed)
#   server = on your own server (see /server), so accounts work on every device
VITE_STORAGE=local

# Only for server mode. Leave empty when the API is served from the same domain as the app
# (recommended; see README). Otherwise the full origin, e.g. https://api.example.com
VITE_API_URL=
