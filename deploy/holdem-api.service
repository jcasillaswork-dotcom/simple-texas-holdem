# systemd unit for the accounts server (server mode only).
# Install: sudo cp deploy/holdem-api.service /etc/systemd/system/ && sudo systemctl enable --now holdem-api
[Unit]
Description=Hold'em accounts API
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/holdem/server
Environment=HOLDEM_DB=/var/lib/holdem/holdem.db
ExecStart=/var/www/holdem/server/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
